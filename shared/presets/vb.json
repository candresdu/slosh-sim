{
  "schema": "slosh-preset/1",
  "id": "vb",
  "title": "Section V.B flight-test sequence",
  "caption": "Gain shift ramps to 2 over 20 s with AAC in Monitor; AAC is engaged at t = 100 s.",
  "durationS": 130,
  "initial": {
    "theta": 0.05,
    "thetaDot": 0.0,
